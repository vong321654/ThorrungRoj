NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
LINE_CLIENT_ID=
LINE_LIFF_ID=
LINE_CLIENT_SECRET=
# Server-only Supabase secret/service-role key. Never prefix this variable with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=
# LINE Messaging API (OA chatbot) — from LINE Developers Console > Messaging API channel
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# Optional: public https origin for chatbot images. Defaults to VERCEL_PROJECT_PRODUCTION_URL on Vercel.
LINE_PUBLIC_BASE_URL=
# Admins who receive slip cards in LINE and can tap Verify/Reject there.
# Format: <LINE userId>:<employees.id>, comma-separated. Send "#myid" to the OA to see your LINE userId.
LINE_SLIP_APPROVERS=
# Shop PromptPay phone number, e.g. 0812345678
PROMPTPAY_PHONE=
# Random string that signs QR image links. Generate with: openssl rand -hex 32
PROMPTPAY_QR_SECRET=
# Random string that protects the daily privacy retention endpoint. Generate with: openssl rand -hex 32
CRON_SECRET=
